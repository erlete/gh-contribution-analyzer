# Deployment configuration for gh-contribution-analyzer.
# Copy to .env and fill in. Only deployment internals live here: operational
# settings (org tokens, mail, AI, recipients, schedules) are configured
# exclusively on the in-app settings screen.

# --- Database ---
POSTGRES_USER=gca
POSTGRES_PASSWORD=change-me
POSTGRES_DB=gca
# Optional: derived from the POSTGRES_* values by compose when unset.
# DATABASE_URL=postgresql+psycopg://gca:change-me@postgres:5432/gca

# --- Application ---
# Fernet key for encrypting credentials at rest. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_SECRET_KEY=
TZ=UTC
# Image tag for production deploys, defaults to latest.
# GCA_TAG=latest

# --- Caddy (the only exposed service, bound to 127.0.0.1 by default) ---
# Port the dashboard is served on. For remote access, front it with your
# own TLS proxy or tunnel. When that proxy runs on another machine, set
# APP_BIND to the interface it reaches (for example the host's private
# LAN IP); basic auth still protects every request.
# APP_PORT=8080
# APP_BIND=127.0.0.1
BASIC_AUTH_USER=root
# IMPORTANT: compose re-interpolates dollar signs in .env values, so every $
# in the bcrypt hash must be doubled as $$. This command does it for you:
# docker run --rm caddy:2 caddy hash-password --plaintext 'your-password' | sed 's/\$/\$\$/g'
BASIC_AUTH_HASH=
