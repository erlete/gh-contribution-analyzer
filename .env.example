# Deployment configuration for gh-contribution-analyzer.
# Copy to .env and fill in. Operational settings (org tokens, recipients, schedules)
# are managed in-app; MAIL_*, SMTP_* and AI_* values only seed initial defaults on
# first boot and can be overridden from the settings screen afterwards.

# --- Database ---
POSTGRES_USER=gca
POSTGRES_PASSWORD=change-me
POSTGRES_DB=gca
# Optional: derived from the POSTGRES_* values by compose when unset.
# DATABASE_URL=postgresql+psycopg://gca:change-me@postgres:5432/gca

# --- Application ---
# Fernet key for encrypting credentials at rest. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_SECRET_KEY=
TZ=UTC
# Image tag for production deploys, defaults to latest.
# GCA_TAG=latest

# --- Caddy (production edge, the only exposed service) ---
# Domain served by Caddy; keep localhost for local production-mode runs.
CADDY_DOMAIN=localhost
BASIC_AUTH_USER=root
# IMPORTANT: compose re-interpolates dollar signs in .env values, so every $
# in the bcrypt hash must be doubled as $$. This command does it for you:
# docker run --rm caddy:2 caddy hash-password --plaintext 'your-password' | sed 's/\$/\$\$/g'
BASIC_AUTH_HASH=

# --- Mail seed: Microsoft Graph backend (production) ---
# Entra ID app registration with application permission Mail.Send and admin consent.
MAIL_AZURE_CLIENT_ID=
MAIL_AZURE_CLIENT_SECRET=
MAIL_AZURE_TENANT_ID=
# Mailbox to send as, e.g. noreply@example.com
MAIL_SENDER_ADDRESS=

# --- Mail seed: SMTP backend (dev compose points these at Mailpit) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SENDER_ADDRESS=

# --- AI seed: OpenAI-compatible endpoint ---
AI_SERVICE_URL=
AI_SERVICE_KEY=
AI_SERVICE_MODEL=
